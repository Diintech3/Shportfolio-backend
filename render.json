{
  "services": [
    {
      "type": "web",
      "name": "tathastu-backend",
      "runtime": "node",
      "plan": "free",
      "buildCommand": "yarn",
      "startCommand": "node index.js",
      "envVars": [
        {
          "key": "GROQ_API_KEY",
          "sync": false
        },
        {
          "key": "CLIENT_URL",
          "sync": false
        }
      ]
    }
  ]
}
